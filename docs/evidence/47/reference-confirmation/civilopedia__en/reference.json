ngs":["source_unavailable"]},{"bounds":[28.800058364868164,933.7499785423279,300.60009956359863,993.6000180244446],"clip_bounds":[0,184,718,1080],"element_ids":["root/1:SplitPane/1:Table/0:SplitPane/0:AutoScrollPane/0:Table/5:Table/0:Label/draw-0"],"ellipsis_applied":false,"human_edited":false,"id":"root/1:SplitPane/1:Table/0:SplitPane/0:AutoScrollPane/0:Table/5:Table/0:Label/draw-0","input_text":"Victory Types","overflow_x":false,"overflow_y":true,"owner_bounds":[28.800058364868164,948.5999965667725,300.60009956359863,993.6000180244446],"primary_denominator":true,"region":"bottom-left","section":"root/1:SplitPane/1:Table/0:SplitPane/0:AutoScrollPane/0:Table/5:Table/0:Label","source":"engine","source_keys":[],"text_seen":"Victory Types","visibility":"full","visible_bounds":[28.800058364868164,933.7499785423279,300.60009956359863,993.6000180244446],"warnings":["source_unavailable"]},{"bounds":[959.4000399112701,320.5079698562622,2144.2681789398193,655.1999866962433],"clip_bounds":[724,184,2400,1080],"element_ids":["root/1:SplitPane/1:Table/0:SplitPane/1:AutoScrollPane/0:Table/0:Table/0:Table/2:Table/0:Label/draw-0"],"ellipsis_applied":false,"human_edited":false,"id":"root/1:SplitPane/1:Table/0:SplitPane/1:AutoScrollPane/0:Table/0:Table/0:Table/2:Table/0:Label/draw-0","input_text":"Production Focus\nIn Civilization V, the Food yield in a city is calculated first, then population grows by consuming stored food (growth), then production is calculated, and so on one by one the other stats are calculated. Thus, citizens can produce yields in the same turn as they are born. The city focus is set to Production to assign the newborn citizen to a hill so they'll contribute Production, and then manually reassigned to a growth tile on the next turn. Alternatively, you can set city focus to Gold (e.g. with Cerro de Potosi), Faith (e.g. with Mount Sinai) or whatever gains the most yields. In Unciv, citizens only start producing yields on the next turn, so you can ignore this whole concept.","overflow_x":false,"overflow_y":true,"owner_bounds":[959.4000399112701,331.2000060081482,2159.999942779541,655.1999866962433],"primary_denominator":true,"region":"center","section":"root/1:SplitPane/1:Table/0:SplitPane/1:AutoScrollPane/0:Table/0:Table/0:Table/2:Table/0:Label","source":"engine","source_keys":[],"text_seen":"Production Focus\nIn Civilization V, the Food yield in a city is calculated first, then population grows by\nconsuming stored food (growth), then production is calculated, and so on one by\none the other stats are calculated. Thus, citizens can produce yields in the same\nturn as they are born. The city focus is set to Production to assign the newborn\ncitizen to a hill so they'll contribute Production, and then manually reassigned to a\ngrowth tile on the next turn. Alternatively, you can set city focus to Gold (e.g. with\nCerro de Potosi), Faith (e.g. with Mount Sinai) or whatever gains the most yields. In\nUnciv, citizens only start producing yields on the next turn, so you can ignore this\nwhole concept.","visibility":"full","visible_bounds":[959.4000399112701,320.5079698562622,2144.2681789398193,655.1999866962433],"warnings":["source_unavailable"]},{"bounds":[959.4000399112701,675.1079857349396,2157.228183746338,912.5999987125397],"clip_bounds":[724,184,2400,1080],"element_ids":["root/1:SplitPane/1:Table/0:SplitPane/1:AutoScrollPane/0:Table/0:Table/0:Table/3:Table/0:Label/draw-0"],"ellipsis_applied":false,"human_edited":false,"id":"root/1:SplitPane/1:Table/0:SplitPane/1:AutoScrollPane/0:Table/0:Table/0:Table/3:Table/0:Label/draw-0","input_text":"Science Queueing\nIn Civilization V, Science yield is calculated after production, so if you finish an item and have Science (or Gold) queued as a perpetual construction, the Production overflow from item will be converted into Science (or Gold), but the Production is not consumed, as this will only happen again on the next turn. By immediately swapping out your perpetual construction for an item on the next turn, you'll get this Science (or Gold) for free. This doesn't apply to Unciv, so don't bother.","overflow_x":false,"overflow_y":true,"owner_bounds":[959.4000399112701,685.7999897003174,2159.999942779541,912.5999987125397],"primary_denominator":true,"region":"bottom","section":"root/1:SplitPane/1:Table/0:SplitPane/1:AutoScrollPane/0:Table/0:Table/0:Table/3:Table/0:Label","source":"engine","source_keys":[],"text_seen":"Science Queueing\nIn Civilization V, Science yield is calculated after production, so if you finish an item\nand have Science (or Gold) queued as a perpetual construction, the Production\noverflow from item will be converted into Science (or Gold), but the Production is\nnot consumed, as this will only happen again on the next turn. By immediately\nswapping out your perpetual construction for an item on the next turn, you'll get this\nScience (or Gold) for free. This doesn't apply to Unciv, so don't bother.","visibility":"full","visible_bounds":[959.4000399112701,675.1079857349396,2157.228183746338,912.5999987125397],"warnings":["source_unavailable"]},{"bounds":[959.4000399112701,934.3079960346222,2148.480176925659,1139.400007724762],"clip_bounds":[724,184,2400,1080],"element_ids":["root/1:SplitPane/1:Table/0:SplitPane/1:AutoScrollPane/0:Table/0:Table/0:Table/4:Table/0:Label/draw-0"],"ellipsis_applied":false,"human_edited":false,"id":"root/1:SplitPane/1:Table/0:SplitPane/1:AutoScrollPane/0:Table/0:Table/0:Table/4:Table/0:Label/draw-0:fragment-0","input_text":"Double Aqueducts\nIn Civilization V, the game sells existing copies of the building for you before providing a free copy of the building. So, if you build an aqueduct in a city, and then in the turn of adopting Tradition Complete you sell a cheap building (e.g a shrine) beforehand, the game is unable to sell more than 1 building per turn, and thus you'll keep your aqueduct, together with the new free aqueduct. Not applicable to Unciv.","overflow_x":false,"overflow_y":true,"owne